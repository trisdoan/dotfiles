#!/bin/bash
set -euo pipefail

omarchy pkg add {{ range .packages.pacman }}{{ . | quote }} {{ end }}

{{ if .packages.aur -}}
omarchy pkg aur add {{ range .packages.aur }}{{ . | quote }} {{ end }}
{{ end -}}

{{ range .packages.flatpak -}}
flatpak info {{ . | quote }} >/dev/null 2>&1 || flatpak install -y --noninteractive flathub {{ . | quote }}
{{ end -}}

{{ if .packages.remove -}}
omarchy pkg drop {{ range .packages.remove }}{{ . | quote }} {{ end }}
{{ end -}}
