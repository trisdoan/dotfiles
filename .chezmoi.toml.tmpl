sourceDir = {{ printf "%q" (joinPath .chezmoi.homeDir "projects/dotfiles") }}

[merge]
    command = "nvim"
    args = [
        "-d",
        {{ printf "%q" "{{ .Destination }}" }},
        {{ printf "%q" "{{ .Source }}" }},
        {{ printf "%q" "{{ .Target }}" }},
    ]

[git]
    autoAdd = false
    autoCommit = false
